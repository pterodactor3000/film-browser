    "build:server": "vite build --ssr",
    "start": "NODE_ENV=production tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-db": "^0.3.7",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
